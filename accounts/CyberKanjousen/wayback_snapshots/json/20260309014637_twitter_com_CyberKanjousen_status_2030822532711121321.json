        "note_tweet": {
          "entities": {
            "urls": [
              {
                "display_url": "support.google.com/googleplay/?p=…",
                "end": 299,
                "expanded_url": "https://support.google.com/googleplay/?p=uncertified_device",
                "start": 276,
